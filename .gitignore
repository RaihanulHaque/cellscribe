# Secrets and local state
.env
*.db
*.db-shm
*.db-wal
__pycache__/
*.pyc
.venv/
venv/

# LibreOffice profile copies must never be committed
**/libreoffice/*/user/

# Built extensions downloaded from the gateway for local install, and database backups
/*.oxt
/gateway/backups/

# LibreOffice document lock files
.~lock.*#
