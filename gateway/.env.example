# Copy to .env and fill in. Never commit .env.
# MISTRAL_API_KEY stays on this server only. Office PCs never see it.

MISTRAL_API_KEY=replace-with-your-mistral-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Admin token for the dashboard and /admin/* endpoints.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CELLSCRIBE_ADMIN_TOKEN=replace-with-a-random-admin-token

# Model choices offered to employees.
CELLSCRIBE_DEFAULT_MODEL=mistral-small-latest
CELLSCRIBE_ALLOWED_MODELS=mistral-small-latest,mistral-medium-latest,mistral-large-latest

CELLSCRIBE_DB=/data/cellscribe.db
CELLSCRIBE_TIMEOUT=300
