# Copy to gateway/.env (this folder; docker compose reads only this one) and fill in.
# Never commit .env. Provider keys stay on this server only; office PCs never see them.

# Providers: set one or both. Model ids with a vendor prefix ("deepseek/...",
# "mistralai/...") go to OpenRouter; bare ids ("mistral-large-latest") go to Mistral.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MISTRAL_API_KEY=replace-with-your-mistral-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Admin token for the dashboard and /admin/* endpoints (at least 16 random characters).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LIBRETHINKERAGENT_ADMIN_TOKEN=replace-with-a-random-admin-token

# Model choices offered to employees. Models whose provider has no key are
# dropped at startup. mistral-small/medium often reply in the sidebar instead of
# calling tools, so the default is a stronger tool-calling model.
LIBRETHINKERAGENT_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017
LIBRETHINKERAGENT_ALLOWED_MODELS=deepseek/deepseek-v4.1-flash-1017,mistral-large-latest,mistral-medium-latest,mistral-small-latest

LIBRETHINKERAGENT_DB=/data/librethinkeragent.db
LIBRETHINKERAGENT_TIMEOUT=300

# URL office PCs use to reach this gateway. Set it on a server, and use the https:// address
# when a TLS proxy is in front (otherwise it is taken from the request).
# LIBRETHINKERAGENT_PUBLIC_URL=http://192.168.1.20:8080

# Prices for the dashboard's cost column, USD per million tokens. OpenRouter models are
# priced automatically (and report their real cost); this is for models it cannot price,
# e.g. Mistral direct. Check Mistral's current price list before filling it in.
# LIBRETHINKERAGENT_PRICES={"mistral-large-latest":{"in":2,"out":6,"cache_read":0.2}}

# Retries for transient upstream failures (dropped connection, 429/502/503/504).
# LIBRETHINKERAGENT_RETRIES=2

# Address the published port binds to. Use 127.0.0.1 when a TLS reverse proxy runs on this host.
# LIBRETHINKERAGENT_BIND=0.0.0.0

# Largest request body accepted, in MB (chat requests are far smaller).
# LIBRETHINKERAGENT_MAX_BODY_MB=20

# Reasoning level for models that think before answering, when the PC does not choose one
# (low | medium | high; empty = provider default). Applies to model ids starting with one of
# LIBRETHINKERAGENT_REASONING_MODELS. "low" keeps DeepSeek from thinking for minutes per step.
# LIBRETHINKERAGENT_REASONING_EFFORT=low
# LIBRETHINKERAGENT_REASONING_MODELS=deepseek/
